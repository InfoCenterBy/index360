    "@tailwindcss/cli": "4.2.1",
    "browser-sync": "^3.0.4",
    "daisyui": "5.5.19",
    "gh-pages": "^6.3.0",
    "gulp": "^4.0.2",
    "gulp-file-include": "^2.3.0",
    "lucide-static": "^0.468.0",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1"
  }
